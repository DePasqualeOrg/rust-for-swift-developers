---
// Adds a sidebar toggle in front of Starlight's site title. On viewports wide enough for the
// docked sidebar, the toggle hides it so the content can use the full width; narrower viewports
// keep Starlight's menu button. The initial state is set by the inline script in
// `astro.config.mjs` before the page renders, so the layout never shifts after load.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="title-group sl-flex">
	{
		hasSidebar && (
			<sidebar-toggle class="print:hidden">
				<button
					type="button"
					aria-controls="starlight__sidebar"
					aria-expanded="true"
					aria-label="Sidebar"
					title="Hide sidebar"
				>
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="3" y="4.5" width="18" height="15" rx="3" />
						<path d="M9.5 4.5v15" />
						<path d="M5.75 8.5h1.25M5.75 11.5h1.25" />
					</svg>
				</button>
			</sidebar-toggle>
		)
	}
	<Default />
</div>

<script>
	class SidebarToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button');
			if (!button) return;
			const root = document.documentElement;
			const sync = () => {
				const collapsed = root.hasAttribute('data-sidebar-collapsed');
				button.setAttribute('aria-expanded', String(!collapsed));
				button.title = collapsed ? 'Show sidebar' : 'Hide sidebar';
			};
			sync();
			button.addEventListener('click', () => {
				const collapsed = root.toggleAttribute('data-sidebar-collapsed');
				try {
					localStorage.setItem('sidebar', collapsed ? 'collapsed' : 'expanded');
				} catch {}
				sync();
			});
		}
	}
	customElements.define('sidebar-toggle', SidebarToggle);
</script>

<style>
	.title-group {
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	sidebar-toggle {
		display: none;
	}

	button {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-inline-start: -0.375rem;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background-color 0.15s,
			color 0.15s;
	}

	@media (hover: hover) {
		button:hover {
			background-color: var(--sl-color-gray-6);
			color: var(--sl-color-white);
		}
	}

	button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}

	svg {
		width: 1.375rem;
		height: 1.375rem;
	}

	@media (min-width: 50rem) {
		sidebar-toggle {
			display: contents;
		}
	}
</style>
