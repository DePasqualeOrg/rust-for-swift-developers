---
// Adds a sidebar toggle in front of Starlight's site title on viewports wide enough for the
// docked sidebar; narrower viewports keep Starlight's menu button. With a pointer, the toggle
// hides the docked sidebar so the content can use the full width, and the choice is remembered.
// On a touch screen the sidebar starts hidden and the toggle slides it over the content. The
// initial state is set by the inline script in `astro.config.mjs` before the page renders.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="title-group sl-flex">
	{
		hasSidebar && (
			<sidebar-toggle class="print:hidden">
				<button
					type="button"
					aria-controls="starlight__sidebar"
					aria-expanded="true"
					aria-label="Sidebar"
					title="Hide sidebar"
				>
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="3" y="4.5" width="18" height="15" rx="3" />
						<path d="M9.5 4.5v15" />
						<path d="M5.75 8.5h1.25M5.75 11.5h1.25" />
					</svg>
				</button>
			</sidebar-toggle>
		)
	}
	<Default />
</div>

<script>
	import { reduceMotion } from '../scripts/motion';

	const touch = matchMedia('(pointer: coarse)');
	const wide = matchMedia('(min-width: 50rem)');

	class SidebarToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button');
			if (!button) return;
			const root = document.documentElement;
			const main = document.querySelector<HTMLElement>('.main-frame');
			const shown = () =>
				touch.matches ? root.hasAttribute('data-sidebar-open') : !root.hasAttribute('data-sidebar-collapsed');
			const sync = () => {
				button.setAttribute('aria-expanded', String(shown()));
				button.title = shown() ? 'Hide sidebar' : 'Show sidebar';
			};

			// On a touch screen the sidebar slides over the content and is not remembered.
			const setOverlay = (open: boolean) => {
				root.toggleAttribute('data-sidebar-open', open);
				main?.toggleAttribute('inert', open);
				sync();
			};
			const scrim = document.createElement('div');
			scrim.className = 'sidebar-scrim';
			scrim.addEventListener('click', () => setOverlay(false));
			document.body.append(scrim);
			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !root.hasAttribute('data-sidebar-open')) return;
				setOverlay(false);
				button.focus();
			});
			wide.addEventListener('change', () => setOverlay(false));

			// With a pointer the sidebar docks; hiding it moves the content, so animate both together.
			const setDocked = (collapsed: boolean) => {
				root.toggleAttribute('data-sidebar-collapsed', collapsed);
				try {
					localStorage.setItem('sidebar', collapsed ? 'collapsed' : 'expanded');
				} catch {}
				sync();
			};

			sync();
			button.addEventListener('click', () => {
				if (touch.matches) return setOverlay(!root.hasAttribute('data-sidebar-open'));
				const collapsed = !root.hasAttribute('data-sidebar-collapsed');
				if (reduceMotion.matches || !document.startViewTransition) return setDocked(collapsed);
				root.setAttribute('data-sidebar-animating', '');
				const transition = document.startViewTransition(() => setDocked(collapsed));
				transition.finished.finally(() => root.removeAttribute('data-sidebar-animating'));
			});
		}
	}
	customElements.define('sidebar-toggle', SidebarToggle);
</script>

<style>
	.title-group {
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	sidebar-toggle {
		display: none;
	}

	button {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-inline-start: -0.375rem;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background-color 0.15s,
			color 0.15s;
	}

	@media (hover: hover) {
		button:hover {
			background-color: var(--sl-color-gray-6);
			color: var(--sl-color-white);
		}
	}

	button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}

	svg {
		width: 1.375rem;
		height: 1.375rem;
	}

	@media (min-width: 50rem) {
		sidebar-toggle {
			display: contents;
		}
	}
</style>
